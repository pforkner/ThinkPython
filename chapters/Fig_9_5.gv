digraph G {
  rankdir=LR
  fontname="Monospace";
  style=filled;
  color=lightgrey;
  node [shape=box, style=filled, color=white, fontname="Monospace"];

  subgraph cluster0 {
    letters;
    label="__main__";
  }

  subgraph cluster1 {
    lst;
    label = "pop_first";
  }

  the_lst [label="['a', 'b', 'c']"]
  letters -> the_lst;
  lst -> the_lst;
}